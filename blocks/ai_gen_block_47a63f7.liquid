{% doc %}
  @prompt
    A magazine-style editorial layout

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    line-height: 1.6;
  }

  .ai-editorial-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
    border-bottom: 1px solid {{ block.settings.accent_color }};
    padding-bottom: 40px;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 20px;
    font-weight: 600;
  }

  .ai-editorial-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-editorial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 30px;
    font-style: italic;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-editorial-meta-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    font-size: 14px;
    color: {{ block.settings.meta_color }};
  }

  .ai-editorial-author-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-editorial-date-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-editorial-date-{{ ai_gen_id }}::before {
    content: '•';
    position: absolute;
    left: -12px;
    color: {{ block.settings.accent_color }};
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 60px;
  }

  .ai-editorial-featured-{{ ai_gen_id }} {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 500px;
    margin-bottom: 30px;
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} p {
    margin-bottom: 20px;
  }

  .ai-editorial-featured-content-{{ ai_gen_id }} p:first-child::first-letter {
    float: left;
    font-size: 72px;
    line-height: 60px;
    padding-right: 8px;
    padding-top: 4px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    color: {{ block.settings.accent_color }};
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  .ai-editorial-sidebar-item-{{ ai_gen_id }} {
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid #e8e8e8;
  }

  .ai-editorial-sidebar-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-editorial-sidebar-image-{{ ai_gen_id }} {
    width: 100%;
    height: 180px;
    margin-bottom: 15px;
    overflow: hidden;
  }

  .ai-editorial-sidebar-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-sidebar-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: 18px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-editorial-sidebar-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.5;
  }

  .ai-editorial-quote-{{ ai_gen_id }} {
    background-color: {{ block.settings.quote_bg_color }};
    padding: 40px;
    margin: 40px 0;
    border-left: 4px solid {{ block.settings.accent_color }};
    font-style: italic;
    font-size: {{ block.settings.quote_size }}px;
    color: {{ block.settings.text_color }};
    position: relative;
  }

  .ai-editorial-quote-{{ ai_gen_id }}::before {
    content: '"';
    font-size: 80px;
    color: {{ block.settings.accent_color }};
    position: absolute;
    top: 10px;
    left: 20px;
    line-height: 1;
    font-family: serif;
  }

  .ai-editorial-quote-text-{{ ai_gen_id }} {
    margin-left: 40px;
  }

  .ai-editorial-tags-{{ ai_gen_id }} {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid #e8e8e8;
  }

  .ai-editorial-tags-label-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.meta_color }};
    margin-bottom: 15px;
    font-weight: 600;
  }

  .ai-editorial-tags-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-editorial-tag-{{ ai_gen_id }} {
    background-color: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.tag_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .ai-editorial-tag-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.accent_color }};
    color: white;
  }

  @media screen and (max-width: 768px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 15px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-editorial-featured-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: auto;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: auto;
    }

    .ai-editorial-featured-image-{{ ai_gen_id }} {
      height: 250px;
      margin-bottom: 20px;
    }

    .ai-editorial-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-editorial-meta-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 10px;
    }

    .ai-editorial-date-{{ ai_gen_id }}::before {
      display: none;
    }

    .ai-editorial-quote-{{ ai_gen_id }} {
      padding: 25px;
      margin: 25px 0;
    }

    .ai-editorial-featured-content-{{ ai_gen_id }} p:first-child::first-letter {
      font-size: 48px;
      line-height: 40px;
    }
  }
{% endstyle %}

<article class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <header class="ai-editorial-header-{{ ai_gen_id }}">
      {% if block.settings.category != blank %}
        <div class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.category }}</div>
      {% endif %}
      
      {% if block.settings.title != blank %}
        <h1 class="ai-editorial-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}
      
      {% if block.settings.subtitle != blank %}
        <div class="ai-editorial-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}<div class="ai-editorial-meta-{{ ai_gen_id }}">
        {% if block.settings.author != blank %}
          <span class="ai-editorial-author-{{ ai_gen_id }}">By {{ block.settings.author }}</span>
        {% endif %}
        {% if block.settings.date != blank %}
          <time class="ai-editorial-date-{{ ai_gen_id }}">{{ block.settings.date }}</time>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <div class="ai-editorial-featured-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <div class="ai-editorial-featured-image-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.featured_image | image_url: width: 800 }}"
            alt="{{ block.settings.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.featured_image.width }}"
            height="{{ block.settings.featured_image.height }}"
          >
        </div>
      {% else %}
        <div class="ai-editorial-featured-image-{{ ai_gen_id }}">
          <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.content != blank %}
        <div class="ai-editorial-featured-content-{{ ai_gen_id }}">
          {{ block.settings.content }}
        </div>
      {% endif %}

      {% if block.settings.quote != blank %}
        <blockquote class="ai-editorial-quote-{{ ai_gen_id }}">
          <div class="ai-editorial-quote-text-{{ ai_gen_id }}">{{ block.settings.quote }}</div>
        </blockquote>
      {% endif %}
    </div>

    <aside class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign sidebar_title_key = 'sidebar_' | append: i | append: '_title'
          assign sidebar_image_key = 'sidebar_' | append: i | append: '_image'
          assign sidebar_excerpt_key = 'sidebar_' | append: i | append: '_excerpt'
          
          assign sidebar_title = block.settings[sidebar_title_key]
          assign sidebar_image = block.settings[sidebar_image_key]
          assign sidebar_excerpt = block.settings[sidebar_excerpt_key]
        %}

        {% if sidebar_title != blank or sidebar_excerpt != blank %}
          <div class="ai-editorial-sidebar-item-{{ ai_gen_id }}">
            {% if sidebar_image %}
              <div class="ai-editorial-sidebar-image-{{ ai_gen_id }}">
                <img
                  src="{{ sidebar_image | image_url: width: 300 }}"
                  alt="{{ sidebar_image.alt | escape }}"
                  loading="lazy"
                  width="{{ sidebar_image.width }}"
                  height="{{ sidebar_image.height }}"
                >
              </div>
            {% else %}
              <div class="ai-editorial-sidebar-image-{{ ai_gen_id }}">
                <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}

            {% if sidebar_title != blank %}
              <h3 class="ai-editorial-sidebar-title-{{ ai_gen_id }}">{{ sidebar_title }}</h3>
            {% endif %}

            {% if sidebar_excerpt != blank %}
              <div class="ai-editorial-sidebar-excerpt-{{ ai_gen_id }}">{{ sidebar_excerpt }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </aside>
  </div>

  {% if block.settings.show_tags and block.settings.tags != blank %}
    <footer class="ai-editorial-tags-{{ ai_gen_id }}">
      <div class="ai-editorial-tags-label-{{ ai_gen_id }}">Tags</div>
      <div class="ai-editorial-tags-list-{{ ai_gen_id }}">
        {% assign tag_list = block.settings.tags | split: ',' %}
        {% for tag in tag_list %}
          <span class="ai-editorial-tag-{{ ai_gen_id }}">{{ tag | strip }}</span>
        {% endfor %}
      </div>
    </footer>
  {% endif %}
</article>

{% schema %}
{
  "name": "Editorial Layout",
  "settings": [
    {
      "type": "header",
      "content": "Article Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header section",
      "default": true
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category",
      "default": "Featured Story"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Article title",
      "default": "The Art of Modern Design"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Exploring the intersection of creativity and functionality in contemporary design"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author name",
      "default": "Editorial Team"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Publication date",
      "default": "March 15, 2024"
    },
    {
      "type": "header",
      "content": "Featured Content"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Article content",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p><p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Pull quote",
      "default": "Design is not just what it looks like and feels like. Design is how it works."
    },
    {
      "type": "header",
      "content": "Sidebar Article 1"
    },
    {
      "type": "text",
      "id": "sidebar_1_title",
      "label": "Title",
      "default": "Related Story"
    },
    {
      "type": "image_picker",
      "id": "sidebar_1_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "sidebar_1_excerpt",
      "label": "Excerpt",
      "default": "A brief look at emerging trends in the design world."
    },
    {
      "type": "header",
      "content": "Sidebar Article 2"
    },
    {
      "type": "text",
      "id": "sidebar_2_title",
      "label": "Title",
      "default": "Industry News"
    },
    {
      "type": "image_picker",
      "id": "sidebar_2_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "sidebar_2_excerpt",
      "label": "Excerpt",
      "default": "Latest updates from the creative industry."
    },
    {
      "type": "header",
      "content": "Sidebar Article 3"
    },
    {
      "type": "text",
      "id": "sidebar_3_title",
      "label": "Title",
      "default": "Expert Opinion"
    },
    {
      "type": "image_picker",
      "id": "sidebar_3_image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "sidebar_3_excerpt",
      "label": "Excerpt",
      "default": "Insights from leading design professionals."
    },
    {
      "type": "header",
      "content": "Tags"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Tags (comma separated)",
      "default": "Design, Modern, Creative, Art, Innovation"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
