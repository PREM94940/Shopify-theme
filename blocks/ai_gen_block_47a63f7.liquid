      "id": "accent_color",
      "label": "Accent color",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "quote_bg_color",
      "label": "Quote background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag background color",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Editorial Layout"
    }
  ]
}
{% endschema %}