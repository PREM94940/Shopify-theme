{% doc %}
  @prompt
    Add a WhatsApp Buy button on the product page, placed above the "Buy it now" button. When clicked, it should open WhatsApp with a pre-filled message containing the product name and URL, directing the customer to purchase via WhatsApp. Style it in WhatsApp green (#25D366) with the WhatsApp icon and label "Buy on WhatsApp". The "Buy it now" button should remain below it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-buy-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-bottom: 12px;
  }

  .ai-whatsapp-buy__button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-whatsapp-buy__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-whatsapp-buy__button-{{ ai_gen_id }}:active {
    transform: translateY(0);
  }

  .ai-whatsapp-buy__icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .ai-whatsapp-buy__text-{{ ai_gen_id }} {
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-buy-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-whatsapp-buy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a
    href="https://wa.me/{{ block.settings.whatsapp_number }}?text={{ block.settings.message_prefix | url_encode }}%20{{ product.title | url_encode }}%20-%20{{ shop.url | append: product.url | url_encode }}"
    class="ai-whatsapp-buy__button-{{ ai_gen_id }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Buy on WhatsApp"
  >
    <svg
      class="ai-whatsapp-buy__icon-{{ ai_gen_id }}"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        fill="currentColor"
      />
    </svg>
    <span class="ai-whatsapp-buy__text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
  </a>
</div>

{% schema %}
{
  "name": "WhatsApp buy button",
  "settings": [
    {
      "type": "header",
      "content": "WhatsApp settings"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Include country code without + or spaces (e.g., 919876543210)"
    },
    {
      "type": "text",
      "id": "message_prefix",
      "label": "Message prefix",
      "default": "Hi, I want to buy this product:"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy on WhatsApp"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#20BA5A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "WhatsApp buy button"
    }
  ]
}
{% endschema %}
